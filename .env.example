# =============================================================================
# DronaSphere — environment
# Copy to .env  ->  cp .env.example .env
# Everything is read from env. Nothing is hardcoded anywhere in the codebase.
# When you get the hosted DB links, ONLY change DATABASE_URL / REDIS_URL below.
# =============================================================================

# ---------- Postgres (local docker default) ----------
POSTGRES_USER=drona
POSTGRES_PASSWORD=drona_dev_password
POSTGRES_DB=dronasphere
POSTGRES_PORT=5432

# Used by Prisma (migrations + seed) AND by the Go API.
# Local docker:   postgresql://drona:drona_dev_password@localhost:5432/dronasphere?schema=public
# Inside docker:  postgresql://drona:drona_dev_password@postgres:5432/dronasphere?schema=public
# Hosted (Neon/Supabase/RDS): paste the link here, add ?sslmode=require
DATABASE_URL=postgresql://drona:drona_dev_password@localhost:5432/dronasphere?schema=public

# ---------- Redis (presence, Owl Board sorted sets, rate limits, ws fanout) ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------- API ----------
API_PORT=8080
API_ENV=development
LOG_LEVEL=debug
# openssl rand -base64 48
JWT_SECRET=dev-only-change-me-2f8a1c6b9e4d7a3f5c8b1e6d9a4f7c2b5e8d1a6f
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
ALLOWED_ORIGINS=http://localhost:3000

# ---------- Campus verification ----------
# Comma separated institutional email domains that auto-verify.
CAMPUS_EMAIL_DOMAINS=dronacharya.info,gcet.ac.in
OTP_TTL=10m
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60s
# log = print the OTP to server logs (dev). smtp = actually send mail.
MAILER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DronaSphere <hello@dronasphere.app>

# ---------- Product rules (PRD section refs in comments) ----------
# 6.1 follow-8 onboarding gate
ONBOARDING_MIN_FOLLOWS=8
# 6.2 Owl Board night window + hard curfew, local time
NIGHT_WINDOW_START=22:00
NIGHT_CURFEW=03:00
# Timezone the two lines above are wall-clock hours in. "Local" in the PRD
# means this, not whatever zone the host OS happens to be set to.
NIGHT_TIMEZONE=Asia/Kolkata
# 6.2 minimum distinct actions before any points count (anti-cheat)
OWL_MIN_ACTIONS=3
OWL_MAX_POINTS_PER_HOUR=120
# 6.2 Cocoon Bonus: hours of continuous inactivity that earn the recovery badge
COCOON_MIN_SLEEP_HOURS=7
COCOON_STARDUST=250
# 6.3 Love Finder stays locked until the campus has this many verified users
DATING_UNLOCK_MIN_USERS=400
# 6.3 a match with no messages wilts after this long, nudged 2 days earlier
MATCH_WILT_DAYS=7
MATCH_NUDGE_DAYS=5

# ---------- Uploaded pictures ----------
# This deployment stores pictures itself, on disk — there is no S3 bucket and
# no third-party host involved.
#
# This value is for running the API directly (`go run ./cmd/api`). In Docker
# it is overridden to /data/media, which is the `media` volume — back that up
# alongside pgdata, because nothing in Postgres can regenerate it.
MEDIA_DIR=./data/media
# Only set this if uploaded pictures must resolve to somewhere other than the
# origin the API itself was reached on (a CDN, a different public path).
# Empty = derive it from each request, which is what you want behind a normal
# reverse proxy.
MEDIA_PUBLIC_BASE_URL=
#
# The 5 MB cap and the images-and-GIFs-only rule (JPEG/PNG/WEBP/GIF, no video)
# are NOT environment variables on purpose — they are constants in
# api/internal/media. A storage budget that a typo in a .env file could
# quietly multiply is not a budget. Change them there and rebuild.

# ---------- Web ----------
WEB_PORT=3000
# These are inlined into the browser bundle at BUILD time, so they must be
# reachable from a user's device — not a docker-network name like
# http://api:8080, which only resolves inside the compose network.
#
#   same machine only:  http://localhost:8080
#   over the LAN:       http://192.168.1.50:8080
#   behind a proxy:     https://drona.example.com
#
# Changing them requires `docker compose build web`, not just a restart.
#
# Leave both EMPTY instead to run web same-origin against its own built-in
# mock API (web/lib/mock-api/app.mjs) rather than the separate Go API in
# api/ — no postgres/redis/api/migrate services needed at all in that case.
# The mock is where every feature actually lands first, so it's ahead of the
# Go API at any given time; point at the Go API only once it has parity with
# whatever you're relying on. Either way, this only behaves consistently
# behind something that runs as one long-lived process (this container,
# `next dev`) — serverless platforms that run concurrent requests on separate
# instances (Vercel included) each get their own copy of the mock's
# in-memory state, so who's "signed in" becomes inconsistent per-request.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/v1/ws
# Absolute-URL metadata only (canonical links, sitemap, og:image) — never used
# for API calls.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Reverse proxy (docker/Caddyfile, profile "full") ----------
# The two hostnames Caddy requests Let's Encrypt certs for and proxies to
# web/api respectively. Point DNS for both at this box's public IP and
# forward TCP 80+443 on your router before `docker compose --profile full up`.
DOMAIN=drona.example.com
API_DOMAIN=api.drona.example.com
