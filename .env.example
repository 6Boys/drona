# =============================================================================
# DronaSphere — environment
# Copy to .env  ->  cp .env.example .env
# Everything is read from env. Nothing is hardcoded anywhere in the codebase.
# When you get the hosted DB links, ONLY change DATABASE_URL / REDIS_URL below.
# =============================================================================

# ---------- Postgres (local docker default) ----------
POSTGRES_USER=drona
POSTGRES_PASSWORD=drona_dev_password
POSTGRES_DB=dronasphere
POSTGRES_PORT=5432

# Used by Prisma (migrations + seed) AND by the Go API.
# Local docker:   postgresql://drona:drona_dev_password@localhost:5432/dronasphere?schema=public
# Inside docker:  postgresql://drona:drona_dev_password@postgres:5432/dronasphere?schema=public
# Hosted (Neon/Supabase/RDS): paste the link here, add ?sslmode=require
DATABASE_URL=postgresql://drona:drona_dev_password@localhost:5432/dronasphere?schema=public

# ---------- Redis (presence, Owl Board sorted sets, rate limits, ws fanout) ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------- API ----------
API_PORT=8080
API_ENV=development
LOG_LEVEL=debug
# openssl rand -base64 48
JWT_SECRET=dev-only-change-me-2f8a1c6b9e4d7a3f5c8b1e6d9a4f7c2b5e8d1a6f
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
ALLOWED_ORIGINS=http://localhost:3000

# ---------- Campus verification ----------
# Comma separated institutional email domains that auto-verify.
CAMPUS_EMAIL_DOMAINS=dronacharya.info,gcet.ac.in
OTP_TTL=10m
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60s
# log = print the OTP to server logs (dev). smtp = actually send mail.
MAILER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DronaSphere <hello@dronasphere.app>

# ---------- Product rules (PRD section refs in comments) ----------
# 6.1 follow-8 onboarding gate
ONBOARDING_MIN_FOLLOWS=8
# 6.2 Owl Board night window + hard curfew, local time
NIGHT_WINDOW_START=22:00
NIGHT_CURFEW=03:00
# Timezone the two lines above are wall-clock hours in. "Local" in the PRD
# means this, not whatever zone the host OS happens to be set to.
NIGHT_TIMEZONE=Asia/Kolkata
# 6.2 minimum distinct actions before any points count (anti-cheat)
OWL_MIN_ACTIONS=3
OWL_MAX_POINTS_PER_HOUR=120
# 6.2 Cocoon Bonus: hours of continuous inactivity that earn the recovery badge
COCOON_MIN_SLEEP_HOURS=7
COCOON_STARDUST=250
# 6.3 Love Finder stays locked until the campus has this many verified users
DATING_UNLOCK_MIN_USERS=400
# 6.3 a match with no messages wilts after this long, nudged 2 days earlier
MATCH_WILT_DAYS=7
MATCH_NUDGE_DAYS=5

# ---------- Web ----------
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/v1/ws
