# The Next.js frontend, built once and served from the standalone output.
#
#   docker compose --profile full up --build
#
# Build context is the REPO ROOT, not ./web — this is an npm workspace and the
# lockfile the install resolves from lives at the top level.
#
# NEXT_PUBLIC_* values are read at BUILD time, not at run time: Next inlines
# them into the browser bundle. That is why they arrive as build args here and
# why changing where the API lives means rebuilding this image, not just
# restarting it. They must be URLs the *browser* can reach — a docker-network
# name like http://api:8080 resolves inside the compose network but not on the
# phone of someone using the app, so this wants the homelab's real address.

# --------------------------------------------------------------- build ----
FROM node:24-alpine AS build

ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL \
    NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

# Manifests first so the install layer is only invalidated when dependencies
# actually move. Installing and building in one stage (rather than copying
# node_modules between stages) is deliberate: npm workspaces may hoist
# everything to the root or leave some of it under web/, and a COPY of a
# path that sometimes doesn't exist is a build that sometimes fails.
COPY package.json package-lock.json ./
COPY web/package.json ./web/
RUN npm ci

COPY web ./web

WORKDIR /app/web
RUN npm run build

# ----------------------------------------------------------------- run ----
FROM node:24-alpine AS runtime

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

WORKDIR /app
RUN addgroup -g 10001 drona && adduser -D -u 10001 -G drona drona

# `output: "standalone"` (next.config.ts) produces a server plus only the
# node_modules it actually reached for — a fraction of the full tree. Static
# assets are not included in it and are copied beside it, as Next's own
# deployment docs specify. The workspace layout is preserved inside the
# standalone bundle, hence the web/ prefixes here and in CMD.
#
# There is no public/ directory in this app (the only static asset, the
# favicon, is generated by app/icon.svg), so nothing is copied for it.
COPY --from=build --chown=drona:drona /app/web/.next/standalone ./
COPY --from=build --chown=drona:drona /app/web/.next/static ./web/.next/static

USER drona
EXPOSE 3000

CMD ["node", "web/server.js"]
